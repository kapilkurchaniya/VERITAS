# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev_password@localhost:5432/nexus
DATABASE_URL_SYNC=postgresql://nexus:nexus_dev_password@localhost:5432/nexus

# ── Auth ───────────────────────────────────────────────
AUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI Providers ───────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# STT uses Groq free whisper endpoint
# STT uses Groq free whisper endpoint
# Embeddings uses Gemini free text-embedding-004

PINECONE_API_KEY=
PINECONE_INDEX_NAME=nexus

# ── Storage ────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# ── Frontend ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend ────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
